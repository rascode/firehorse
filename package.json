{
  "name": "@rascode/firehorse",
  "version": "1.1.0",
  "description": "Firehorse — a dark-first, container-native CSS design system. Cascade layers, container queries, light-dark() theming, no JavaScript required.",
  "license": "MIT",
  "author": "Rascode (https://rascode.dev)",
  "homepage": "https://firehorse.rascode.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rascode/firehorse.git"
  },
  "bugs": "https://github.com/rascode/firehorse/issues",
  "keywords": [
    "design-system",
    "css",
    "container-queries",
    "cascade-layers",
    "dark-mode",
    "light-dark",
    "design-tokens",
    "firehorse",
    "schema-org",
    "structured-data",
    "json-ld",
    "themes",
    "social-media",
    "slides",
    "reveal.js"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/firehorse.js",
    "./dist/sidecar.js",
    "./dist/money.js",
    "./dist/tabs-nav.js"
  ],
  "style": "./dist/firehorse.css",
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": "./dist/firehorse.css",
    "./css": "./dist/firehorse.css",
    "./min.css": "./dist/firehorse.min.css",
    "./compat.css": "./dist/firehorse.compat.min.css",
    "./themes/*": "./dist/themes/*",
    "./themes.css": "./dist/themes.css",
    "./themes.json": "./dist/themes.json",
    "./email": "./src/email/email.js",
    "./index.json": "./dist/index.json",
    "./src/*": "./src/*",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./agent/*": "./agent/*",
    "./package.json": "./package.json",
    "./js": "./dist/firehorse.js",
    "./firehorse.js": "./dist/firehorse.js",
    "./schema/mappings.json": "./schema/mappings.json",
    "./admin.css": "./dist/admin.css",
    "./admin.min.css": "./dist/admin.min.css",
    "./icons.css": "./dist/icons.css",
    "./icons.json": "./dist/icons.json",
    "./reveal.css": "./dist/reveal.css",
    "./datatable": {
      "types": "./dist/datatable.d.ts",
      "default": "./dist/datatable.js"
    },
    "./datatable.js": {
      "types": "./dist/datatable.d.ts",
      "default": "./dist/datatable.js"
    },
    "./audio": "./dist/audio.js",
    "./audio.js": "./dist/audio.js",
    "./sidecar": {
      "types": "./dist/sidecar.d.ts",
      "default": "./dist/sidecar.js"
    },
    "./sidecar.js": {
      "types": "./dist/sidecar.d.ts",
      "default": "./dist/sidecar.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./money.js": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./tabs-nav": {
      "types": "./dist/tabs-nav.d.ts",
      "default": "./dist/tabs-nav.js"
    },
    "./tabs-nav.js": {
      "types": "./dist/tabs-nav.d.ts",
      "default": "./dist/tabs-nav.js"
    },
    "./sections.json": "./sections.json"
  },
  "files": [
    "dist",
    "src",
    "agent",
    "mcp",
    "index-ledger.json",
    "sections.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "schema",
    "scripts/schema.mjs",
    "scripts/audit.mjs",
    "scripts/gen-themes.mjs",
    "scripts/export-media.mjs",
    "templates"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "npm run lint && npm run build && node scripts/verify.mjs && node scripts/verify-adaptive.mjs && node scripts/schema-test.mjs && node scripts/gen-index.mjs --check && node scripts/audit-test.mjs && node test/mcp.test.mjs",
    "prepublishOnly": "npm test && node scripts/gen-index.mjs",
    "site": "node scripts/gen-horse.mjs && node scripts/gen-index.mjs && node scripts/agent-docs.mjs && node scripts/patterns-docs.mjs && node scripts/templates.mjs && node scripts/site.mjs --check && node scripts/stable.mjs && node scripts/email-previews.mjs && node scripts/pack-site.mjs && node scripts/not-found.mjs && node scripts/schema.mjs $(node scripts/pages.mjs --dist) --write",
    "deploy:site": "npm test && npm run site && npx wrangler@4 deploy",
    "schema": "node scripts/schema.mjs $(node scripts/pages.mjs --dist)",
    "audit": "node scripts/audit.mjs",
    "tokens:adaptive": "node scripts/gen-adaptive.mjs"
  },
  "devDependencies": {
    "browserslist": "4.29.5",
    "lightningcss": "1.33.0",
    "lucide-static": "^0.469.0",
    "marked": "^14.1.4",
    "playwright": "^1.56.1"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "firefox >= 128",
    "safari >= 17.5"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "node-html-parser": "^7.0.1",
    "zod": "^3.25.76"
  },
  "bin": {
    "firehorse-schema": "./scripts/schema.mjs",
    "firehorse-audit": "./scripts/audit.mjs",
    "firehorse-theme": "./scripts/gen-themes.mjs",
    "firehorse-export": "./scripts/export-media.mjs",
    "firehorse-mcp": "./mcp/server.mjs"
  }
}
