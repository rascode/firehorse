{
  "name": "firehorse",
  "base": true,
  "label": "Firehorse",
  "breed": "Firehorse",
  "tagline": "The base system. Etched lines, ember on charcoal.",
  "description": "Firehorse as it ships: etched dashed cards, flat buttons, rounded avatars and dashed chips on a charcoal canvas with the ember accent. Use data-fh-theme=\"firehorse\" to restore the defaults inside a themed page.",
  "type": {
    "value": { "size": "var(--fh-text-small)", "weight": "var(--fh-weight-regular)", "tracking": "var(--fh-tracking-body)" },
    "figure": { "tracking": "var(--fh-tracking-mono)" },
    "name": { "weight": "var(--fh-weight-medium)" },
    "meta": { "size": "var(--fh-text-caption)", "weight": "var(--fh-weight-regular)", "tracking": "var(--fh-tracking-body)" },
    "label": { "size": "var(--fh-text-label)", "weight": "var(--fh-weight-medium)", "tracking": "var(--fh-tracking-wide)", "case": "uppercase" },
    "fieldFloor": "1rem"
  },
  "config": {
    "avatar": "rounded",
    "avatarPerson": "circle",
    "avatarEntity": "rounded",
    "card": "etched",
    "cardMedia": "wide",
    "button": "flat",
    "chip": "dashed",
    "radius": "default",
    "density": "comfortable",
    "table": "lined",
    "rows": "md"
  },
  "tokens": {
    "--fh-heading-size": "clamp(1.4rem, 1rem + 1.5vw, 2.2rem)",
    "--fh-heading-weight": "var(--fh-weight-heavy)",
    "--fh-heading-tracking": "var(--fh-tracking-tight)",
    "--fh-display-weight": "var(--fh-weight-heavy)",
    "--fh-subheading-weight": "var(--fh-weight-bold)"
  }
}
