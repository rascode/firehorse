{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firehorse.rascode.dev/schema/semantic-types.schema.json",
  "title": "Semantic types",
  "description": "The one field list, as published from devops.semantic_types by the platform's publish-firehorse-codex.mts into schema/semantic-types.json. Every type has a display shape from display-rules.json (migrations 434, 435): no type is left without one.",
  "type": "object",
  "required": ["publishedFrom", "types"],
  "additionalProperties": false,
  "properties": {
    "publishedFrom": {
      "const": "devops.semantic_types"
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/type"
      }
    }
  },
  "$defs": {
    "type": {
      "type": "object",
      "required": ["key", "display"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_()]*$"
        },
        "label": {
          "type": ["string", "null"]
        },
        "display": {
          "$ref": "#/$defs/display"
        }
      }
    },
    "display": {
      "type": "object",
      "required": ["shape"],
      "additionalProperties": false,
      "properties": {
        "shape": {
          "description": "How the value is drawn: one of the 14 shapes in display-rules.json.",
          "enum": ["text", "prose", "number", "money", "ratio", "temporal", "option", "options", "entity", "file", "link", "flag", "code", "series", "place"]
        },
        "kind": {
          "description": "Narrows the shape for the grid (status, ordinal, person, duration, id, secret …).",
          "type": ["string", "null"]
        },
        "unit": {
          "description": "The suffix a number shows (min, kbps, gwei).",
          "type": ["string", "null"]
        },
        "optionSet": {
          "description": "The option set the type draws from (schema/option-sets.json); every option and options type has one.",
          "type": ["string", "null"]
        },
        "currencyFrom": {
          "description": "For money: the semantic type of the sibling field that names the currency.",
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "shape": {
                "enum": ["option", "options"]
              }
            }
          },
          "then": {
            "required": ["shape", "optionSet"],
            "properties": {
              "optionSet": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
