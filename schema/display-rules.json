{
  "$comment": "Firehorse data display contract: how a value is drawn, everywhere. Source of truth for src/js/values.js (resolveValue, via scripts/value-rules.mjs), agent/components/values.md and the UI audit. Plan: platform relay/2026-11-14-data-display-contract-plan.md. Version 2 (W2b, plan section 7): series is the 14th shape, text the sixth context, option sets come from schema/option-sets.json (devops.option_sets), priority is ordinal with a tone ramp. A variant with `of` is the same Values part as that shape's variant of the same ID. Rows of the grid are matched in order; the first row whose shape and match fit the field wins. Every variant carries its Firehorse Index ID (VAL-1.1 …), the part drawn at /data/values/.",
  "version": 2,
  "shapes": {
    "text": "short words",
    "prose": "long words",
    "number": "a count or measure",
    "money": "an amount with a currency",
    "ratio": "a part of a whole",
    "temporal": "a moment or a span",
    "option": "one value from a known set",
    "options": "several values from a set",
    "entity": "a thing with an identity",
    "file": "a stored file or media",
    "link": "an address you can open",
    "flag": "yes or no",
    "code": "an identifier shown in mono",
    "series": "a list of numbers over time"
  },
  "contexts": {
    "cell": "a datatable or table row",
    "record": "a label and value row: sidecar, record table, review",
    "card": "gallery, board, tile",
    "metric": "the big figure",
    "form": "editing",
    "text": "the plain string for CSV export, aria-label, copy and search; never drawn"
  },
  "modes": [
    "read",
    "edit"
  ],
