{
  "$comment": "Firehorse data display contract: how a value is drawn, everywhere. Source of truth for src/js/values.js (resolveValue, via scripts/value-rules.mjs), agent/components/values.md and the UI audit. Plan: platform relay/2026-11-14-data-display-contract-plan.md. Rows of the grid are matched in order; the first row whose shape and match fit the field wins.",
  "version": 1,
  "shapes": {
    "text": "short words",
    "prose": "long words",
    "number": "a count or measure",
    "money": "an amount with a currency",
    "ratio": "a part of a whole",
    "temporal": "a moment or a span",
    "option": "one value from a known set",
    "options": "several values from a set",
    "entity": "a thing with an identity",
    "file": "a stored file or media",
    "link": "an address you can open",
    "flag": "yes or no",
    "code": "an identifier shown in mono"
  },
  "contexts": {
    "cell": "a datatable or table row",
    "record": "a label and value row: sidecar, record table, review",
    "card": "gallery, board, tile",
    "metric": "the big figure",
    "form": "editing"
  },
  "modes": [
    "read",
    "edit"
  ],
  "grid": [
    {
      "row": "option.status",
      "label": "option, status (toned)",
      "shape": "option",
      "match": {
        "kind": [
          "status"
        ]
      },
      "cell": "dot",
      "record": "chip",
      "card": "chip",
      "metric": "chip",
      "form": "select",
      "note": "Status is a chip once per row; the dot is for dense cells and prose only."
    },
    {
      "row": "option.few",
      "label": "option, 2 to 4 values",
      "shape": "option",
      "match": {
        "count": [
          2,
          4
        ]
      },
      "cell": "chip",
      "record": "chip",
      "card": "chip",
      "metric": null,
      "form": "segmented"
    },
    {
      "row": "option.many",
      "label": "option, 8 or more values",
      "shape": "option",
      "match": {
        "count": [
          8,
          null
        ]
      },
      "cell": "chip",
      "record": "chip",
      "card": "chip",
      "metric": null,
      "form": "select-search"
    },
    {
      "row": "option",
      "label": "option, 5 to 7 values (or unknown)",
      "shape": "option",
      "cell": "chip",
      "record": "chip",
      "card": "chip",
      "metric": null,
      "form": "select",
      "note": "Not in the approved grid: fills the gap between 4 and 8 values."
    },
    {
      "row": "options",
      "label": "options",
      "shape": "options",
      "cell": "chips",
      "record": "chips-inline",
      "card": "chips",
      "metric": "count",
      "form": "tag-field",
      "max": {
        "cell": 3,
        "card": 2
      }
    },
    {
      "row": "entities",
      "label": "entities (several)",
      "shape": "entity",
      "match": {
        "multiple": true
      },
      "cell": "stack",
      "record": "avatar-name",
      "card": "stack",
      "metric": "stack",
      "form": "picker-multi",
      "max": {
        "cell": 4
      },
      "note": "Record context lists one per line."
    },
    {
      "row": "entity.person",
      "label": "entity, person or org",
      "shape": "entity",
      "match": {
        "kind": [
          "person",
          "org"
        ]
      },
      "cell": "avatar-name",
      "record": "full",
      "card": "chip",
      "metric": "stack",
      "form": "picker"
    },
    {
      "row": "entity.record",
      "label": "entity, record",
      "shape": "entity",
      "cell": "ref",
      "record": "ref-key",
      "card": "name",
      "metric": null,
      "form": "picker",
      "note": "The form picker row shows name and description."
    },
    {
      "row": "money",
      "label": "money",
      "shape": "money",
      "cell": "amount",
      "record": "amount-code",
      "card": "compact",
      "metric": "compact-delta",
      "form": "money-input",
      "align": {
        "cell": "end",
        "record": "end"
      },
      "mono": true
    },
    {
      "row": "ratio",
      "label": "ratio",
      "shape": "ratio",
      "cell": "bar",
      "record": "text",
      "card": "ring",
      "metric": "ring",
      "form": "range",
      "note": "Metric uses meter instead of ring when the field has a target."
    },
    {
      "row": "number.series",
      "label": "number, series",
      "shape": "number",
      "match": {
        "kind": [
          "series"
        ]
      },
      "cell": "sparkline",
      "record": "sparkline",
      "card": "sparkline",
      "metric": "sparkline",
      "form": null
    },
    {
      "row": "number",
      "label": "number",
      "shape": "number",
      "cell": "plain",
      "record": "unit",
      "card": "plain",
      "metric": "plain-delta",
      "form": "number-input",
      "align": {
        "cell": "end",
        "record": "end"
      }
    },
    {
      "row": "temporal.date",
      "label": "temporal, date",
      "shape": "temporal",
      "match": {
        "kind": [
          "date"
        ]
      },
      "cell": "date-relative",
      "record": "date",
      "card": "relative",
      "metric": "relative",
      "form": "date-picker"
    },
    {
      "row": "temporal.time",
      "label": "temporal, time of day",
      "shape": "temporal",
      "match": {
        "kind": [
          "time"
        ]
      },
      "cell": "time",
      "record": "time",
      "card": "time",
      "metric": null,
      "form": "time-input",
      "note": "Not in the approved grid: a time of day has no relative form."
    },
    {
      "row": "temporal.duration",
      "label": "temporal, duration",
      "shape": "temporal",
      "match": {
        "kind": [
          "duration"
        ]
      },
      "cell": "duration",
      "record": "duration",
      "card": "duration",
      "metric": "duration",
      "form": "duration-input",
      "note": "Not in the approved grid: durations were an open item from the value inventory."
    },
    {
      "row": "temporal",
      "label": "temporal, moment",
      "shape": "temporal",
      "cell": "date-relative",
      "record": "datetime",
      "card": "relative",
      "metric": "relative",
      "form": "date-picker"
    },
    {
      "row": "file",
      "label": "file",
      "shape": "file",
      "cell": "type-chip",
      "record": "file-row",
      "card": "thumb",
      "metric": "count",
      "form": "dropzone",
      "max": {
        "cell": 3
      }
    },
    {
      "row": "link.email",
      "label": "link, email",
      "shape": "link",
      "match": {
        "kind": [
          "email"
        ]
      },
      "cell": "email",
      "record": "email",
      "card": "link-chip",
      "metric": null,
      "form": "email-input"
    },
    {
      "row": "link.phone",
      "label": "link, phone",
      "shape": "link",
      "match": {
        "kind": [
          "phone"
        ]
      },
      "cell": "phone",
      "record": "phone",
      "card": "link-chip",
      "metric": null,
      "form": "phone-input"
    },
    {
      "row": "link.action",
      "label": "link, action (computed button)",
      "shape": "link",
      "match": {
        "kind": [
          "action"
        ]
      },
      "cell": "action",
      "record": "action",
      "card": "action",
      "metric": null,
      "form": null,
      "note": "Not in the approved grid: computed_button is an action, not a value."
    },
    {
      "row": "link",
      "label": "link, URL",
      "shape": "link",
      "cell": "link",
      "record": "link",
      "card": "link-chip",
      "metric": null,
      "form": "url-input"
    },
    {
      "row": "flag",
      "label": "flag",
      "shape": "flag",
      "cell": "check",
      "record": "yes-no",
      "card": "yes-no",
      "metric": "count",
      "form": "switch"
    },
    {
      "row": "prose",
      "label": "prose",
      "shape": "prose",
      "cell": "clamp-2",
      "record": "full",
      "card": "clamp-3",
      "metric": null,
      "form": "textarea"
    },
    {
      "row": "code.secret",
      "label": "code, secret (vault reference)",
      "shape": "code",
      "match": {
        "kind": [
          "secret"
        ]
      },
      "cell": "masked",
      "record": "masked",
      "card": "masked",
      "metric": null,
      "form": "key-field",
      "mono": true,
      "note": "Not in the approved grid: credential types store a vault reference, never the value."
    },
    {
      "row": "code.json",
      "label": "code, structured (JSON)",
      "shape": "code",
      "match": {
        "kind": [
          "json"
        ]
      },
      "cell": "mono",
      "record": "code-block",
      "card": "mono",
      "metric": null,
      "form": "textarea-mono",
      "mono": true,
      "note": "Not in the approved grid: JSON needs a block in the record."
    },
    {
      "row": "code",
      "label": "code",
      "shape": "code",
      "cell": "mono",
      "record": "copyable",
      "card": "mono",
      "metric": null,
      "form": "input-mono",
      "mono": true
    },
    {
      "row": "text",
      "label": "text",
      "shape": "text",
      "cell": "line",
      "record": "line",
      "card": "line",
      "metric": null,
      "form": "input",
      "note": "Not in the approved grid (the plan's grid had no text row)."
    }
  ],
